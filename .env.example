# ============================================================
# Resourceful — environment variable template
# Copy to .env.local for local development.
# Never commit populated environment files or paste secrets into Git history.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ============================================================

# ---- AI: OpenAI is the active runtime provider -------------------------------
OPENAI_API_KEY=

# Defaults are defined in src/config/ai.ts. Pin explicit model IDs in production
# after representative property and filing evals.
AI_MODEL_PRIMARY=gpt-5.6-sol
AI_MODEL_RESEARCH=gpt-5.6-terra
AI_MODEL_FAST=gpt-5.6-luna
AI_MODEL_VISION=gpt-5.6-sol
AI_MODEL_DOCUMENT=gpt-5.6-sol

# Reasoning controls. High is the default for appraiser/vision/document work;
# increase to max only when evals justify added cost and latency.
AI_REASONING_APPRAISER=high
AI_REASONING_RESEARCH=medium
AI_REASONING_FAST=low
AI_REASONING_VISION=high
AI_REASONING_DOCUMENT=high

# ---- Supabase: use a dedicated Resourceful project, never Wireline ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# ---- Property data -----------------------------------------------------------
# Treat every vendor credential as server-only unless explicitly documented.
ATTOM_API_KEY=
# ATTOM_API_BASE_URL=https://api.gateway.attomdata.com/propertyapi/v1.0.0

# Optional fallbacks/enrichment. Enable only after contract and cost review.
LIGHTBOX_API_KEY=
LIGHTBOX_API_SECRET=
RENTCAST_API_KEY=
REGRID_API_KEY=
SERPER_API_KEY=

# ---- Maps and imagery --------------------------------------------------------
AZURE_MAPS_SUBSCRIPTION_KEY=
NEXT_PUBLIC_AZURE_MAPS_CLIENT_ID=
NEXT_PUBLIC_MAPILLARY_ACCESS_TOKEN=

# ---- Payments ---------------------------------------------------------------
# Use test-mode keys until the complete production flow is verified.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Transactional email ----------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS=reports@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=your@email.com

# ---- Optional physical filing -----------------------------------------------
LOB_API_KEY=

# ---- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
FOUNDER_EMAILS=

# Unique random values. Use at least 32 characters and never reuse either value.
CRON_SECRET=
REPORT_ACCESS_TOKEN_SECRET=

# ---- Observability -----------------------------------------------------------
LOG_LEVEL=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
